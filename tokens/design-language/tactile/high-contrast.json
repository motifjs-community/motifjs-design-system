  "focus": {
    "ring": {
      "$description": "The one focus visual for everything: outer ring plus inner ring.",
      "color": {
        "$type": "color",
        "$value": "{color.contrast.text}"
      },
      "inner": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "halo": {
        "$type": "shadow",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "hex": "#000000"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 1,
              "unit": "px"
            }
          }
        ]
      },
      "halo-inset": {
