  "elevation": {
    "$description": "The shadow level of each kind of surface: a card on the page, a popup (menus, drop-down lists), a tooltip, a toast, a window, a window that is not active, and a modal dialog.",
    "$type": "shadow",
    "card": {
      "$value": "{shadow.2}"
    },
    "popup": {
      "$value": "{shadow.16}"
    },
    "tooltip": {
      "$value": "{shadow.8}"
    },
    "toast": {
      "$value": "{shadow.16}"
    },
    "window": {
      "$value": "{shadow.28}"
    },
    "window-inactive": {
      "$value": "{shadow.8}"
    },
    "dialog": {
      "$value": "{shadow.64}"
    }
  },
